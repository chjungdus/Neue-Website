# E-Mail (Resend) - https://resend.com
RESEND_API_KEY=re_...
CONTACT_EMAIL=nexuzo.kontakt@gmail.com

# Supabase - https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Service role key: Supabase Dashboard -> Project Settings -> API -> service_role.
# Server-only, never add the NEXT_PUBLIC_ prefix. Powers the admin dashboard
# (reading Anfragen, managing Portfolio) by bypassing Row Level Security after
# the admin login check. Keep this secret out of the client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Admin-Passwort (beliebiger sicherer String)
ADMIN_SECRET=ihr-sicheres-passwort-hier

# App URL
NEXTAUTH_URL=http://localhost:3000
