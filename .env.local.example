# E-Mail-Benachrichtigung bei neuen Anfragen — läuft über euer eigenes
# Gmail-Konto, kein zusätzlicher Dienst nötig.
# So kommt ihr an ein App-Passwort:
# 1. Google-Konto -> Sicherheit -> "Bestätigung in zwei Schritten" aktivieren
#    (falls noch nicht an)
# 2. Google-Konto -> Sicherheit -> "App-Passwörter" -> neues Passwort für
#    "Mail" erstellen -> das 16-stellige Passwort hier eintragen
GMAIL_USER=nexuzo.kontakt@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Wer die Benachrichtigung bekommt. Optional, fällt sonst auf GMAIL_USER zurück.
CONTACT_EMAIL=nexuzo.kontakt@gmail.com

# Supabase - https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Service role key: Supabase Dashboard -> Project Settings -> API -> service_role
# (bzw. der neue "secret"-Key unter API Keys). Server-only, nie mit dem
# NEXT_PUBLIC_ Präfix versehen. Ermöglicht dem Admin-Bereich (Anfragen lesen,
# Portfolio verwalten), Row Level Security nach dem Admin-Login zu umgehen.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Admin-Passwort (beliebiger sicherer String)
ADMIN_SECRET=ihr-sicheres-passwort-hier
